---
import '../../styles/forum.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/icons/Icon.astro';
import { forumCategories, forumPosts } from '../../data/forum';
import { blogPosts, getBlogPostTimestamp } from '../../data/blog';
import { resolvePageSeo } from '../../config/seo';
import { breadcrumbSchema, collectionPageSchema } from '../../utils/schema';
import { SITE_LOGO_ALT } from '../../utils/imageAlt';

const seo = resolvePageSeo('/forum/');
const breadcrumbs = [{ name: 'Home', path: '/' }, { name: 'Forum', path: '/forum/' }];
const categoryKey = (name: string) => name.toLowerCase().replace(/[^a-z0-9]/g, '');
const sourceTimestamp = (path?: string) => {
  const slug = path?.split('/').filter(Boolean).at(-1);
  const article = blogPosts.find((item) => item.slug === slug);
  return article ? getBlogPostTimestamp(article.date) : 0;
};
---

<BaseLayout title={seo.title} description={seo.description} jsonLd={[
  collectionPageSchema({ name: 'Community forum placeholder', description: seo.description, url: '/forum/' }),
  breadcrumbSchema(breadcrumbs),
]}>
  <section class="forum-page py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <article class="content-markdown border-b border-border pb-8 md:pb-10">
        <h2>Offers, proof, and where to ask questions</h2>
        <p>
          This forum indexes discussion-style posts that point back to money guides—not a separate checkout.
          Plan previews on the site hero remain <strong>$35 monthly</strong> and <strong>$150 lifetime</strong> until the vendor cart shows otherwise.
        </p>
        <p>
          Screenshot proof lives on module pages; compare <a href="/arc-raiders-esp/">ESP loot gallery</a> and <a href="/arc-raiders-aimbot/">smoothing and FOV field notes</a> before you treat a thread as product truth.
          License delivery and refunds are answered through vendor support linked from the <a href="/support/">support ticket formatting guide</a>.
        </p>
        <h2>Common thread topics (FAQ-style)</h2>
        <ul>
          <li><strong>Setup</strong> — Windows 64-bit builds, GPU stutter after overlays, Defender exclusions (vendor PDF only).</li>
          <li><strong>Plans</strong> — monthly renewal versus lifetime HWID caps; confirm on vendor cart.</li>
          <li><strong>DMA</strong> — indoor radar drift after firmware; link the <a href="/guides/cloud-dma-setup/">DMA validation checklist</a>.</li>
          <li><strong>Enforcement</strong> — account vs hardware flags; cite the <a href="/arc-raiders-account-vs-hardware-ban/">ban factsheet</a>.</li>
        </ul>
        <h2>What we moderate out</h2>
        <p>
          Checkout URLs that bypass documented bridges, cracked loaders, and claims we cannot match to a dated still on this domain.
          Affiliate questions go to the <a href="/affiliate-disclosure/">forum affiliate policy</a>.
        </p>
        <h2>Offer table (preview)</h2>
        <table>
          <thead><tr><th>Topic</th><th>On-site proof</th><th>Not answered here</th></tr></thead>
          <tbody>
            <tr><td>Core plan</td><td>Homepage hero $35 / $150</td><td>Tax and coupons</td></tr>
            <tr><td>ESP filters</td><td>Showcase still filenames</td><td>Live detection</td></tr>
            <tr><td>DMA</td><td>Indoor breach gallery</td><td>Firmware refunds</td></tr>
          </tbody>
        </table>
        <p>
          Before opening vendor checkout, skim the <a href="/faq/">structured FAQ article</a> and
          <a href="/guides/system-requirements/">64-bit requirements table</a> so your thread includes GPU and Windows build context.
        </p>
        <h2>Proof files to attach in threads</h2>
        <p>
          Attach at most three screenshots: one ESP still match, one menu still, and one error string from vendor loader if setup failed.
          Name files the same way showcase assets are named so moderators can compare quickly.
        </p>
        <h2>Threads we elevate after patches</h2>
        <p>
          Patch-day threads that include before/after still swaps get pinned until module articles update.
          Claims without filenames stay in the reply queue until a guide editor verifies the caption.
        </p>
        <h2>Vendor contact boundaries</h2>
        <p>
          Do not post raw license keys, invoice PDFs with full addresses, or chargeback threats.
          Route billing disputes to vendor support and cite receipt SKUs exactly as printed.
        </p>
        <p>
          For DMA troubleshooting, link the indoor breach still and note whether Hyper-V was enabled during the test session.
        </p>
        <h2>Spam and affiliate transparency</h2>
        <p>
          Affiliates may discuss commissions openly but must link the disclosure page when they paste checkout URLs.
          Unlabeled referral links are removed; repeat offenders lose posting privileges on this index.
        </p>
        <p>
          Questions about outdated captions on money URLs should include the guide slug and the still filename you compared.
          Mention whether the issue is on a hardware ban page, ESP gallery, or checkout FAQ so editors route it correctly.
        </p>
      </article>
      <header class="forum-hero">
        <div>
          <p class="section-header__eyebrow">Community Q&A</p>
          <h1>ARC Cheats community forum</h1>
          <p class="forum-hero__copy">Indexed threads highlight setup wins, patch-day still swaps, and links into the public FAQ.</p>
        </div>
        <a class="forum-create" href="/blog/"><Icon name="messageCircle" size={17} /> Explore the guides</a>
      </header>

      <div class="forum-layout">
        <main class="forum-main" aria-label="Community posts">
          <div class="forum-toolbar">
            <div class="forum-sort" role="group" aria-label="Post sorting">
              <button class="is-active" type="button" data-forum-sort="popular" aria-pressed="true">Popular</button>
              <button type="button" data-forum-sort="latest" aria-pressed="false">Latest</button>
              <button type="button" data-forum-sort="top" aria-pressed="false">Most discussed</button>
            </div>
            <label class="forum-search">
              <Icon name="search" size={16} />
              <input type="search" placeholder="Search discussions" aria-label="Search discussions" data-forum-search />
              <span class="sr-only" data-forum-count>{forumPosts.length} discussions</span>
            </label>
          </div>

          <div class="forum-category-filters" role="group" aria-label="Filter discussions by topic">
            <button type="button" class="is-active" data-forum-filter="all" aria-pressed="true"><Icon name="layers" size={14} /> All topics</button>
            {forumCategories.map((category) => (
              <button type="button" data-forum-filter={categoryKey(category.name)} aria-pressed="false"><Icon name={category.icon} size={14} /> {category.name}</button>
            ))}
          </div>
          <p class="forum-results-count" data-forum-visible-count>{forumPosts.length} guide discussions</p>

          <div class="forum-post-list" aria-live="polite">
            {forumPosts.map((post, index) => (
              <article class="forum-post-card" data-forum-card data-post-slug={post.slug} data-upvotes={post.upvotes} data-category={categoryKey(post.category)} data-comments={post.commentsCount} data-published={sourceTimestamp(post.sourcePath)} data-order={index}>
                <div class="forum-vote" aria-label="Discussion voting">
                  <button class="forum-vote__up" type="button" data-vote-up aria-label="Upvote this discussion"><Icon name="chevronDown" size={16} /></button>
                  <strong data-vote-count>{post.upvotes}</strong>
                  <button type="button" disabled aria-label="Downvoting is unavailable"><Icon name="chevronDown" size={16} /></button>
                </div>
                <div class="forum-post-card__body">
                  <div class="forum-post-meta">
                    <span class={`forum-community-avatar tone-${post.categoryTone}`}><Icon name="users" size={15} /></span>
                    <a href={`#communities`} class="forum-community-name">
                      {post.category} board index
                    </a>
                    <span>·</span><span><Icon name="userRound" size={13} /> Moderator placeholder</span><span>Guide-based Q&amp;A</span>
                  </div>
                  <a class="forum-post-title" href={`/forum/${post.slug}/`}>{post.title}</a>
                  <p class="forum-post-excerpt">{post.excerpt}</p>
                  {post.sourceTitle && <p class="forum-source">From the guide: <a href={post.sourcePath}>{post.sourceTitle}</a></p>}
                  <div class="forum-post-actions">
                    {post.flair && <span class={`forum-flair tone-${post.categoryTone}`}>{post.flair}</span>}
                    <a href={`/forum/${post.slug}/`}><Icon name="messageCircle" size={15} /> {post.commentsCount} comments</a>
                    <a href={`/forum/${post.slug}/`}><Icon name="arrowRight" size={15} /> Read discussion</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
          <p class="forum-empty" data-forum-empty hidden>No discussions match. Try another search or topic.</p>
          <nav class="forum-pagination" aria-label="Discussion pages" data-forum-pagination hidden>
            <button type="button" data-page-previous aria-label="Previous page">Previous</button>
            <div class="forum-pagination__pages" data-page-buttons></div>
            <button type="button" data-page-next aria-label="Next page">Next</button>
            <span class="forum-pagination__status" data-page-status aria-live="polite"></span>
          </nav>
        </main>

        <aside class="forum-sidebar">
          <section class="forum-side-card forum-about" id="community-guidelines">
            <div class="forum-side-card__banner"></div>
            <div class="forum-about__content">
              <div class="forum-about__title"><span class="forum-community-avatar forum-community-avatar--brand"><img src="/logo.svg" alt={SITE_LOGO_ALT} width="34" height="34" /></span><h2>Community placeholder</h2></div>
              <p>Sidebar description placeholder for your forum or community hub.</p>
              <div class="forum-stats"><span><b>{forumPosts.length}</b> guide discussions</span><span><b>{forumCategories.length}</b> topics</span></div>
              <a class="forum-join" href="/blog/">Explore all guides</a>
            </div>
          </section>
          <section class="forum-side-card" id="communities">
            <h2 class="forum-side-heading">Communities</h2>
            <ul class="forum-community-list">
              {forumCategories.map((category, index) => (
                <li><a href={`/forum/?category=${categoryKey(category.name)}`}><span class={`forum-community-avatar tone-${category.tone}`} aria-hidden="true"><Icon name={category.icon} size={15} /></span><span><b>{category.name}</b><small>Browse related Q&amp;A</small></span><Icon name="chevronRight" size={15} /></a></li>
              ))}
            </ul>
            <a class="forum-text-link" href="#communities">Browse all communities <Icon name="arrowRight" size={14} /></a>
          </section>
          <section class="forum-side-card forum-rules">
            <h2 class="forum-side-heading">Community guidelines</h2>
            <ol><li>Keep it friendly and constructive</li><li>Stay on topic and add context</li><li>Mark spoilers and sensitive content</li></ol>
            <a href="#community-guidelines">Read the full guidelines <Icon name="arrowRight" size={14} /></a>
          </section>
          <p class="forum-sidebar-foot">About · Guidelines · Privacy · Terms<br />© {new Date().getFullYear()} Site name placeholder</p>
        </aside>
      </div>
    </div>
  </section>
  <script>
    const cards = [...document.querySelectorAll<HTMLElement>('[data-forum-card]')];
    const sortButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-forum-sort]')];
    const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-forum-filter]')];
    const searchInput = document.querySelector<HTMLInputElement>('[data-forum-search]');
    const list = document.querySelector<HTMLElement>('.forum-post-list');
    const pagination = document.querySelector<HTMLElement>('[data-forum-pagination]');
    const pageButtons = document.querySelector<HTMLElement>('[data-page-buttons]');
    const pageStatus = document.querySelector<HTMLElement>('[data-page-status]');
    const countStatus = document.querySelector<HTMLElement>('[data-forum-count]');
    const visibleCount = document.querySelector<HTMLElement>('[data-forum-visible-count]');
    const emptyState = document.querySelector<HTMLElement>('[data-forum-empty]');
    const previousButton = document.querySelector<HTMLButtonElement>('[data-page-previous]');
    const nextButton = document.querySelector<HTMLButtonElement>('[data-page-next]');
    const pageSize = 20;
    let currentPage = 1;
    let activeFilter = new URLSearchParams(window.location.search).get('category') ?? 'all';

    function updateForum() {
      const sort = sortButtons.find((button) => button.getAttribute('aria-pressed') === 'true')?.dataset.forumSort ?? 'popular';
      const query = searchInput?.value.trim().toLocaleLowerCase() ?? '';
      const ordered = [...cards].sort((a, b) => {
        if (sort === 'latest') return Number(b.dataset.published) - Number(a.dataset.published);
        if (sort === 'top') return Number(b.dataset.comments) - Number(a.dataset.comments);
        return Number(a.dataset.order) - Number(b.dataset.order);
      });
      const matching = ordered.filter((card) => {
        const matchesCategory = activeFilter === 'all' || card.dataset.category === activeFilter;
        return matchesCategory && (!query || card.textContent?.toLocaleLowerCase().includes(query));
      });
      const pageCount = Math.max(1, Math.ceil(matching.length / pageSize));
      currentPage = Math.min(currentPage, pageCount);
      const firstVisible = (currentPage - 1) * pageSize;
      const visibleCards = new Set(matching.slice(firstVisible, firstVisible + pageSize));

      ordered.forEach((card) => {
        card.hidden = !visibleCards.has(card);
        list?.append(card);
      });

      if (countStatus) countStatus.textContent = `${matching.length} ${matching.length === 1 ? 'discussion' : 'discussions'}`;
      if (visibleCount) visibleCount.textContent = `${matching.length} ${matching.length === 1 ? 'discussion' : 'discussions'}`;
      if (emptyState) emptyState.hidden = matching.length > 0;
      if (pagination) pagination.hidden = matching.length <= pageSize;
      if (pageStatus) pageStatus.textContent = matching.length
        ? `Showing ${firstVisible + 1}–${Math.min(firstVisible + pageSize, matching.length)} of ${matching.length}`
        : '0 discussions';
      if (previousButton) previousButton.disabled = currentPage <= 1;
      if (nextButton) nextButton.disabled = currentPage >= pageCount;
      if (pageButtons) {
        pageButtons.replaceChildren(...Array.from({ length: pageCount }, (_, index) => {
          const button = document.createElement('button');
          const page = index + 1;
          button.type = 'button';
          button.textContent = String(page);
          button.setAttribute('aria-label', `Page ${page}`);
          if (page === currentPage) button.setAttribute('aria-current', 'page');
          button.addEventListener('click', () => {
            currentPage = page;
            updateForum();
          });
          return button;
        }));
      }
    }

    sortButtons.forEach((button) => button.addEventListener('click', () => {
      sortButtons.forEach((item) => {
        const active = item === button;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      currentPage = 1;
      updateForum();
    }));

    filterButtons.forEach((button) => button.addEventListener('click', () => {
      activeFilter = button.dataset.forumFilter ?? 'all';
      filterButtons.forEach((item) => {
        const active = item === button;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      currentPage = 1;
      updateForum();
    }));

    searchInput?.addEventListener('input', () => {
      currentPage = 1;
      updateForum();
    });
    previousButton?.addEventListener('click', () => {
      currentPage = Math.max(1, currentPage - 1);
      updateForum();
    });
    nextButton?.addEventListener('click', () => {
      currentPage += 1;
      updateForum();
    });

    const initialFilter = filterButtons.find((button) => button.dataset.forumFilter === activeFilter);
    if (initialFilter) {
      filterButtons.forEach((item) => {
        const active = item === initialFilter;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });
    } else {
      activeFilter = 'all';
    }
    updateForum();
  </script>
  <script>
    import { initForumVotes } from '../../scripts/forum-votes.ts';
    initForumVotes();
  </script>
</BaseLayout>
