---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegalPage from '../../components/LegalPage.astro';
import { getPageSeoEntry } from '../../config/pageSeo';
import { breadcrumbSchema, webPageSchema } from '../../utils/schema';

const seo = getPageSeoEntry('/affiliate-disclosure/')!;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Affiliate disclosure', path: '/affiliate-disclosure/' },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  logoAlt="Affiliate disclosure – site logo"
  jsonLd={[
    webPageSchema({ name: seo.title, description: seo.description, url: '/affiliate-disclosure/' }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <LegalPage
    title="Affiliate disclosure"
    description="How arc-cheats.net earns from checkout links and what that means for readers in the United States."
    breadcrumbLabel="Affiliate disclosure"
    sections={[
      {
        heading: 'Affiliate relationships',
        paragraphs: [
          'Some links on this site route through affiliate partners before you reach the vendor checkout page. We may earn a commission when you complete a purchase, at no extra cost to you.',
          'Product screenshots and copy describe modules we preview on this domain; the vendor delivers licenses and support after payment.',
          'Checkout bridges under /go/ are excluded from search indexing so engines index guides, not interim redirect pages.',
        ],
      },
      {
        heading: 'Editorial independence',
        paragraphs: [
          'We publish independent guides and do not guarantee detection status, ban rates, or feature parity with every game patch.',
          'Commissions do not decide sort order in navigation. Money pages are listed because shoppers search those modules, not because a partner pays extra.',
          'Compare plans on the homepage, read the ban guide, and confirm pricing on the vendor page before you buy.',
        ],
      },
      {
        heading: 'Offers shown in guides',
        paragraphs: [
          'Hero and article copy may cite $35 monthly or $150 lifetime figures as budgeting previews. Tax, coupons, and currency conversion appear only on the vendor cart.',
          'Optional DMA or HWID products bill separately when your cart includes them. We label those paths in the FAQ and setup guides so you are not surprised at checkout.',
        ],
      },
      {
        heading: 'Proof we publish',
        paragraphs: [
          'Screenshots are captured on our test rigs and stored under /images/showcase/. Alt text describes what each still proves—distance readouts, loot filters, menu tabs, or indoor lighting.',
          'When a module changes visually after a patch, we update stills and note the publish date in the article frontmatter where available.',
        ],
      },
      {
        heading: 'FAQ',
        paragraphs: [
          'Do affiliate links track me? Partners may set cookies on their domain when you click through; see the vendor privacy policy for retention.',
          'Can I buy without supporting the site? Type the vendor URL directly if you prefer; guides remain public either way.',
          'Who answers billing questions? The vendor support inbox on your receipt—not the arc-cheats.net contact form.',
        ],
      },
      {
        heading: 'Updates to this disclosure',
        paragraphs: [
          'We revise this page when checkout partners change, when plan previews on the homepage move, or when US FTC guidance on affiliate labeling shifts.',
          'Material changes post here first; footer links always point to this URL so returning shoppers can diff expectations before a renewal charge.',
          'Ask privacy or commission questions through the contact form with “disclosure” in the subject if something on a money URL disagrees with this text.',
        ],
      },
    ]}
  />
</BaseLayout>