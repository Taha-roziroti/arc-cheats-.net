---
import { CHECKOUT_BRIDGE_SLUGS, checkoutDestinationForSlug } from '../../config/checkout-redirects.mjs';

export function getStaticPaths() {
  return CHECKOUT_BRIDGE_SLUGS.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const destination = checkoutDestinationForSlug(slug ?? '');

if (!destination) {
  return Astro.redirect('/go/');
}
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>Checkout</title>
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <link rel="preconnect" href="https://zadeyo.com" crossorigin />
    <link rel="dns-prefetch" href="https://zadeyo.com" />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <script is:inline define:vars={{ destination }}>
      window.location.replace(destination);
    </script>
    <style>
      html,
      body {
        margin: 0;
        min-height: 100%;
        background: #0f0f14;
      }
    </style>
  </head>
  <body>
    <noscript>
      <p>
        <a href={destination} rel="sponsored noopener noreferrer">Continue to checkout</a>
      </p>
    </noscript>
  </body>
</html>