---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactSupportSection from '../components/ContactSupportSection.astro';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';

const seo = resolvePageSeo('/support/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Support', path: '/support/' },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  logoAlt="Support – site logo"
  jsonLd={[
    webPageSchema({
      name: t.support.title,
      description: t.support.subtitle,
      url: '/support/',
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="border-b border-border bg-muted/20 py-8 md:py-10">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
    </div>
  </section>

  <ContactSupportSection titleId="support-page-title" showTicketTips />

  <article class="content-markdown border-t border-border bg-muted/10 py-10 md:py-12">
    <div class="mx-auto max-w-3xl px-5">
      <h2 class="text-lg font-semibold text-foreground">Before you contact support</h2>
      <p>
        Check plan figures on the homepage hero, skim the <a href="/faq/">pre-purchase question list</a>, and read the
        <a href="/guides/system-requirements/">Arc Raiders client setup guide</a> before you email support.
      </p>
      <p>
        Checkout happens on the vendor site linked from <a href="/go/">/go/</a>; this domain does not deliver license keys directly.
      </p>
      <h2>Information to include in every ticket</h2>
      <p>
        Send your order email, the product name on the receipt, your Windows build, and any error text or screenshots.
      </p>
      <h2>Response expectations</h2>
      <p>
        Email replies are manual; refund timing follows the vendor policy attached to your checkout.
      </p>
      <h2>Feature and pricing questions</h2>
      <p>
        Use the <a href="/arc-raiders-esp/">ESP stills article</a>, <a href="/arc-raiders-aimbot/">aimbot option notes</a>, and
        <a href="/arc-raiders-account-vs-hardware-ban/">account versus hardware ban primer</a> for module detail before you open checkout.
      </p>
    </div>
  </article>
</BaseLayout>
